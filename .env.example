# Application
PORT=4000
NODE_ENV=development

# Database (matches docker-compose defaults)
POSTGRES_USER=dating
POSTGRES_PASSWORD=dating_secret
POSTGRES_DB=dating_db
POSTGRES_PORT=5432
DATABASE_URL="postgresql://dating:dating_secret@localhost:5432/dating_db"

# Redis (matches docker-compose defaults)
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_ACCESS_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Email (Resend) — https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM="Dating App <noreply@yourdomain.com>"
MAGIC_LINK_BASE_URL=http://localhost:3000

# AWS S3 (for photo uploads)
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=dating-app-photos

# pgAdmin (docker-compose only, not used by app)
PGADMIN_EMAIL=admin@dating.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
